{
  "name": "@sebastienaglae/aura",
  "version": "0.1.0",
  "description": "Aura — a voice-reactive orb and a set of generative-AI loading animations (image, song, video, text). Framework-agnostic with optional React bindings. A Dash Systems product.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./gen": "./src/aura-gen.js",
    "./react": "./src/aura-react.jsx",
    "./native": "./src/aura-native.jsx",
    "./native/gen": "./src/aura-native-gen.jsx"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "voice", "orb", "ai", "generative", "animation", "ui",
    "web-audio", "speech", "react", "loading", "shimmer", "dash-systems"
  ],
  "author": "Dash Systems",
  "license": "MIT",
  "homepage": "https://github.com/sebastienaglae/aura",
  "repository": { "type": "git", "url": "https://github.com/sebastienaglae/aura.git" },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "check": "node --check src/aura.js && node --check src/aura-gen.js && node --check src/index.js",
    "smoke": "node --input-type=module -e \"import('./src/index.js').then(m=>{if(!m.VoiceOrb||!m.ImageGen||!m.Aura)throw new Error('missing exports');console.log('exports ok');})\""
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "react-native": ">=0.70",
    "@shopify/react-native-skia": ">=0.1.200",
    "react-native-reanimated": ">=3",
    "expo-linear-gradient": ">=12"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "react-native": { "optional": true },
    "@shopify/react-native-skia": { "optional": true },
    "react-native-reanimated": { "optional": true },
    "expo-linear-gradient": { "optional": true }
  }
}
